# Optional server-side configuration. The application works without LAS.
# Copy to endless-tuna/.env, fill values locally, then restart API/worker.
# Never use VITE_* variables for credentials. Never commit .env.
LAS_API_BASE_URL=https://llm-west.ncsu-las.net/v1
LAS_API_KEY=
LAS_MODEL=
LAS_TIMEOUT_SECONDS=90
# OPENAI_KEY is a compatibility fallback ONLY if LAS_API_KEY is absent/unset.
# An explicitly empty LAS_API_KEY does not use OPENAI_KEY.
# OPENAI_KEY=
# TUNA_DATA_DIR=/absolute/path/to/endless-tuna-data
# Local supervisor ports (./start.sh); binding remains 127.0.0.1.
TUNA_API_PORT=8000
TUNA_UI_PORT=5173

# Public collection traffic (separate from the LAS gateway).
TUNA_DOWNLOAD_CONCURRENCY=2
TUNA_DOWNLOAD_TIMEOUT_SECONDS=30
TUNA_REQUEST_INTERVAL_SECONDS=0.4
TUNA_MAX_PDF_MB=30
# Optional public JSON search endpoint; see endless-tuna/docs/collection.md.
# No provider is assumed or silently substituted. Missing provider enables manual search.
# TUNA_SEARCH_ENDPOINT=https://your-search-gateway.example/search

# Disk-backed local exports; ZIP values are MB (1,000,000 bytes).
TUNA_ZIP_MAX_MB=100
TUNA_EXPORT_TOTAL_MB=1024
TUNA_EXPORT_MAX_PAPERS=10000
TUNA_EXPORT_TTL_HOURS=24
